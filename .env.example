# ─────────────────────────────────────────────────────────────────────────────
# talentconnect — variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env (ignoré par git) et compléter les valeurs.
# Sur Vercel : Project Settings → Environment Variables.
#
# ⚠️  NE JAMAIS committer un .env réel. Ce fichier ne doit contenir que
#     des valeurs factices ou laissées vides.
#
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────


# ─── Supabase ────────────────────────────────────────────────────────────────
# SUPABASE_URL est public (c'est le hostname du projet) et apparaît déjà
# dans les anciens scripts ; SUPABASE_SECRET_KEY ne l'est PAS : c'est la clé
# service_role, elle contourne les RLS et ne doit jamais quitter le serveur.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=


# ─── Sécurité — secrets applicatifs ─────────────────────────────────────────
# CRON_SECRET : protège /api/process-candidatures, /api/brevo-stats et
# /api/confirm-candidature (Authorization: Bearer).
# Vercel envoie automatiquement ce header pour le cron déclaré dans vercel.json.
CRON_SECRET=

# ADMIN_SECRET : token d'administration retourné par /api/admin/login puis
# envoyé en Bearer sur les endpoints /api/admin/*. À garder distinct de
# CRON_SECRET pour pouvoir les révoquer séparément.
ADMIN_SECRET=

# ADMIN_USER / ADMIN_PASS : identifiants du back-office.
# L'ancien couple admin / admin123 a été retiré du code : il ne doit plus
# exister aucune valeur par défaut.
ADMIN_USER=
ADMIN_PASS=

# OAUTH_STATE_SECRET : secret HMAC qui signe le paramètre `state` du flux
# OAuth Gmail (anti-CSRF + anti-Open Redirect sur le callback).
# Si absent, /api/gmail?action=auth répond 503 plutôt que d'accepter un
# state non signé.
OAUTH_STATE_SECRET=


# ─── Paiement (Stripe) ──────────────────────────────────────────────────────
# STRIPE_SECRET_KEY : clé API Stripe (sk_live_... ou sk_test_...).
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET : secret de signature du endpoint webhook
# (Stripe Dashboard → Developers → Webhooks → Signing secret).
# Sans lui, /api/webhook rejette tous les événements (constructEvent échoue).
STRIPE_WEBHOOK_SECRET=


# ─── Email (Brevo) ───────────────────────────────────────────────────────────
# Clé API v3 Brevo : Brevo → SMTP & API → API Keys → "v3 API key".
BREVO_API_KEY=


# ─── Recherche d'emails de contact (Hunter.io) ───────────────────────────────
# Hunter.io → API Keys.
HUNTER_API_KEY=


# ─── Offres d'emploi (Adzuna) ────────────────────────────────────────────────
# Adzuna → Developer → API keys (app_id et app_key).
# Utilisé par api/adzuna-jobs.js pour les réponses aux offres publiées.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=


# ─── Génération des lettres (Anthropic) ──────────────────────────────────────
# Clé API Anthropic (console.anthropic.com → API Keys).
# Utilisée par api/process-candidatures.js pour rédiger les lettres.
ANTHROPIC_API_KEY=


# ─── OAuth Gmail (Google Cloud) ─────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# L'URI de redirection autorisée doit être exactement :
#   https://www.lancemonjob.fr/api/gmail?action=callback
# Portées : gmail.send, userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
